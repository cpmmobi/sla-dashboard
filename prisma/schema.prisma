// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Admin {
  id          String   @id @default(cuid())
  username    String   @unique
  password    String
  displayName String
  role        String   @default("super_admin")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Customer {
  id                  String   @id @default(cuid())
  name                String
  authCode            String   @unique
  domain              String
  domainsJson         String   @default("[]")
  status              String
  timezone            String
  contact             String
  notes               String
  accountManagerEmail String?
  renewalDay          Int?
  monthlyGiftCreditUsd Float?
  cumulativeGiftCreditUsd Float?
  availableRechargeUsd Float?
  cumulativeRechargeUsd Float?
  trafficMarkupPercent  Float?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  reportAccessLogs    CustomerReportAccessLog[]
  balanceAccount      CustomerBalanceAccount?
  balanceLedgerEntries BalanceLedgerEntry[]
  dailySettlementSnapshots CustomerDailySettlementSnapshot[]
  billingStatements   BillingStatement[]
}

model CustomerReportAccessLog {
  id           String   @id @default(cuid())
  customerId   String
  ipAddress    String
  userAgent    String?
  accessedAt   DateTime @default(now())
  viewedByAdminAt DateTime?
  customer     Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId, accessedAt])
  @@index([customerId, viewedByAdminAt])
}

model Announcement {
  id               String                  @id @default(cuid())
  titleZh          String
  titleEn          String
  contentZh        String
  contentEn        String
  startsAt         DateTime?
  endsAt           DateTime?
  enabled          Boolean                 @default(true)
  createdByUsername String?
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt
  dismissals       AnnouncementDismissal[]

  @@index([enabled, startsAt, endsAt, createdAt])
}

model AnnouncementDismissal {
  id             String       @id @default(cuid())
  announcementId String
  ipAddress      String
  dismissedAt    DateTime     @default(now())
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)

  @@unique([announcementId, ipAddress])
  @@index([ipAddress, dismissedAt])
}

model CustomerBalanceAccount {
  id                       String                           @id @default(cuid())
  customerId               String                           @unique
  rechargeBalanceUsd       Float                            @default(0)
  monthlyGiftBalanceUsd    Float                            @default(0)
  cumulativeGiftBalanceUsd Float                            @default(0)
  lastSnapshotAt           DateTime?
  lastSettledAt            DateTime?
  createdAt                DateTime                         @default(now())
  updatedAt                DateTime                         @updatedAt
  customer                 Customer                         @relation(fields: [customerId], references: [id], onDelete: Cascade)
  ledgerEntries            BalanceLedgerEntry[]
  dailySnapshots           CustomerDailySettlementSnapshot[]
  billingStatements        BillingStatement[]
}

model BalanceLedgerEntry {
  id                             String                 @id @default(cuid())
  customerBalanceAccountId       String
  customerId                     String
  entryType                      String
  direction                      String
  amountUsd                      Float
  rechargeDeltaUsd               Float                  @default(0)
  monthlyGiftDeltaUsd            Float                  @default(0)
  cumulativeGiftDeltaUsd         Float                  @default(0)
  balanceAfterRechargeUsd        Float
  balanceAfterMonthlyGiftUsd     Float
  balanceAfterCumulativeGiftUsd  Float
  cycleStartAt                   DateTime?
  cycleEndAt                     DateTime?
  effectiveAt                    DateTime?
  note                           String                 @default("")
  referenceType                  String?
  referenceId                    String?
  createdByUsername              String?
  createdAt                      DateTime               @default(now())
  balanceAccount                 CustomerBalanceAccount @relation(fields: [customerBalanceAccountId], references: [id], onDelete: Cascade)
  customer                       Customer               @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId, createdAt])
  @@index([customerId, entryType, cycleStartAt])
  @@index([referenceType, referenceId])
}

model CustomerDailySettlementSnapshot {
  id                       String                 @id @default(cuid())
  customerBalanceAccountId String
  customerId               String
  snapshotDate             DateTime
  periodStartAt            DateTime
  periodEndAt              DateTime
  totalTrafficGb           Float                  @default(0)
  totalCostUsd             Float                  @default(0)
  matchedDomainCount       Int                    @default(0)
  totalDomainCount         Int                    @default(0)
  status                   String                 @default("pending")
  failureReason            String?
  detailsJson              String                 @default("{}")
  createdAt                DateTime               @default(now())
  updatedAt                DateTime               @updatedAt
  balanceAccount           CustomerBalanceAccount @relation(fields: [customerBalanceAccountId], references: [id], onDelete: Cascade)
  customer                 Customer               @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([customerId, snapshotDate])
  @@index([status, snapshotDate])
}

model BillingStatement {
  id                       String                 @id @default(cuid())
  customerBalanceAccountId String
  customerId               String
  statementType            String                 @default("daily_charge")
  statementDate            DateTime
  cycleStartAt             DateTime?
  cycleEndAt               DateTime?
  periodStartAt            DateTime
  periodEndAt              DateTime
  totalTrafficGb           Float                  @default(0)
  trafficCostUsd           Float                  @default(0)
  monthlyGiftDeductedUsd   Float                  @default(0)
  cumulativeGiftDeductedUsd Float                 @default(0)
  rechargeDeductedUsd      Float                  @default(0)
  remainingAmountUsd       Float                  @default(0)
  matchedDomainCount       Int                    @default(0)
  totalDomainCount         Int                    @default(0)
  status                   String                 @default("pending")
  failureReason            String?
  summaryJson              String                 @default("{}")
  note                     String                 @default("")
  settledAt                DateTime?
  createdByUsername        String?
  createdAt                DateTime               @default(now())
  updatedAt                DateTime               @updatedAt
  balanceAccount           CustomerBalanceAccount @relation(fields: [customerBalanceAccountId], references: [id], onDelete: Cascade)
  customer                 Customer               @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@unique([customerId, statementType, statementDate])
  @@index([customerId, statementDate])
  @@index([status, statementDate])
}
