// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Admin {
  id          String   @id @default(cuid())
  username    String   @unique
  password    String
  displayName String
  role        String   @default("super_admin")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Customer {
  id                  String   @id @default(cuid())
  name                String
  authCode            String   @unique
  domain              String
  domainsJson         String   @default("[]")
  status              String
  timezone            String
  contact             String
  notes               String
  accountManagerEmail String?
  renewalDay          Int?
  monthlyGiftTrafficGb Float?
  trafficMarkupPercent Float?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  reportAccessLogs    CustomerReportAccessLog[]
}

model CustomerReportAccessLog {
  id           String   @id @default(cuid())
  customerId   String
  ipAddress    String
  userAgent    String?
  accessedAt   DateTime @default(now())
  viewedByAdminAt DateTime?
  customer     Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)

  @@index([customerId, accessedAt])
  @@index([customerId, viewedByAdminAt])
}

model Announcement {
  id               String                  @id @default(cuid())
  titleZh          String
  titleEn          String
  contentZh        String
  contentEn        String
  startsAt         DateTime?
  endsAt           DateTime?
  enabled          Boolean                 @default(true)
  createdByUsername String?
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt
  dismissals       AnnouncementDismissal[]

  @@index([enabled, startsAt, endsAt, createdAt])
}

model AnnouncementDismissal {
  id             String       @id @default(cuid())
  announcementId String
  ipAddress      String
  dismissedAt    DateTime     @default(now())
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)

  @@unique([announcementId, ipAddress])
  @@index([ipAddress, dismissedAt])
}
