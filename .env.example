# Vercel Postgres
# On Vercel, these variables are provided automatically after you connect Vercel Postgres.
POSTGRES_PRISMA_URL=""
POSTGRES_URL_NON_POOLING=""

# Optional local aliases if you prefer to keep Prisma on the conventional variable names.
DATABASE_URL=""
DIRECT_URL=""

# Alibaba Cloud Live OpenAPI credentials
ALIYUN_LIVE_ACCESS_KEY_ID=""
ALIYUN_LIVE_ACCESS_KEY_SECRET=""
ALIYUN_LIVE_SECURITY_TOKEN=""
ALIYUN_LIVE_REGION_ID="cn-shanghai"
